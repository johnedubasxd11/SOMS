# ============================================================================
# SOMS environment variables - copy to .env.local and fill in the values.
#   Local Supabase:  npx supabase status -o env   (paste the output below)
#   Hosted project:  Supabase Dashboard -> Project Settings -> API
# NEVER commit .env.local - it is git-ignored.
# ============================================================================

# --- Supabase: safe to expose to the browser (anon key only) ---------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase: SERVER ONLY. No NEXT_PUBLIC_ prefix, ever. ------------------
# Used by route handlers / server actions / seed scripts only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email notifications (Phase 5, https://resend.com) ---------------------
RESEND_API_KEY=re_your-api-key
EMAIL_FROM="SOMS <no-reply@acdeducation.com>"

# --- Supabase CLI (only needed for a hosted project: db push / gen types) --
SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_ID=your-project-ref

# --- Seed script (npm run seed:auth) + browser smoke test -------------------
# Password given to every seeded account. REQUIRED - there is no default in
# the source on purpose. Pick your own; change the accounts after first login.
SEED_PASSWORD=

# --- Cron fallback for requirement reminders (Phase 5) ---------------------
# POST /api/cron/reminders with header:  Authorization: Bearer $CRON_SECRET
# Needed only where pg_cron is not installed (local Supabase, plain VMs).
CRON_SECRET=generate-a-long-random-string
